{
  "openapi": "3.1.0",
  "info": {
    "title": "Gradus API",
    "version": "1.0.0",
    "description": "Gradus /api/v1 — see docs/api/README.md and docs/ios/PRD.md §6.2."
  },
  "servers": [
    {
      "url": "https://gradus.training"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Supabase access token"
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {}
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/v1/meta/config": {
      "get": {
        "summary": "Public feature flags and terms version",
        "security": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "paywallEnabled": {
                      "type": "boolean"
                    },
                    "coachProEnabled": {
                      "type": "boolean"
                    },
                    "foundingCoachCutoff": {
                      "type": "string"
                    },
                    "termsVersion": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "paywallEnabled",
                    "coachProEnabled",
                    "foundingCoachCutoff",
                    "termsVersion"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meta/client-policy": {
      "get": {
        "summary": "Minimum supported client version and force-update message",
        "security": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "minSupportedVersion": {
                      "type": "object",
                      "properties": {
                        "ios": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "ios"
                      ]
                    },
                    "message": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "minSupportedVersion",
                    "message"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me/presence": {
      "post": {
        "summary": "Bump the caller's last-seen timestamp",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    }
                  },
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me/terms": {
      "get": {
        "summary": "Terms-of-service acceptance status for the caller",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accepted": {
                      "type": "boolean"
                    },
                    "version": {
                      "type": "string"
                    },
                    "acceptedAt": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "accepted",
                    "version",
                    "acceptedAt"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
